# Copy to .env.judge.local; the local file is excluded from Git.
OPENAI_MODEL=gpt-5.6terra
# API base URL supplied by your model provider.
OPENAI_BASE_URL=https://api.vip1129.cc/v1
# Fill this only in .env.judge.local, never in the example or chat.
OPENAI_API_KEY=
# chat_completions or responses (match the provider documentation).
JUDGE_API_STYLE=chat_completions
JUDGE_TIMEOUT=120
JUDGE_MAX_RETRIES=2
